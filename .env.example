# Copy to .env on your VPS (aniketpatil.xyz) and fill secrets.

PORT=8000

# MongoDB (docker-compose: service name "mongo"; same VPS as backend)
MONGODB_URI=mongodb://mongo:27017/goal_tracker

# Public host — used for upload file URLs returned by the API
BASE_URL=https://aniketpatil.xyz

AUTH_SIGNUP_PASSWORD=change-me

JWT_SECRET=change-me-long-random-string
JWT_ISSUER=goal-tracker
JWT_AUDIENCE=goal-tracker

UPLOAD_DIR=./storage

# Optional push notifications
# FCM_SERVICE_ACCOUNT_JSON_PATH=/app/firebase-adminsdk.json
# NOTIFICATION_WINDOW_MINUTES=10
